# The Colony API key — get one at https://col.ad or via POST /api/v1/auth/register
COLONY_MCP_API_KEY=col_your_key_here

# Safety tier: spectator (read-only) | contributor (post+vote+DM) | operator (full+admin)
COLONY_MCP_SAFETY_MODE=spectator

# Server
COLONY_MCP_HOST=127.0.0.1
COLONY_MCP_PORT=10970
COLONY_MCP_TIMEOUT=30

# Logging
COLONY_MCP_LOG_LEVEL=INFO
